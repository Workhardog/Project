.vscode/extensions.json
.vscode/launch.json
.vscode/settings.json

# ── AI 模型檔（體積龐大，改用 Releases 發布）────
# ONNX 模型
Assets/PassthroughCameraApiSamples/MultiObjectDetection/SentisInference/Model/*.onnx
# Sentis 序列化模型
Assets/PassthroughCameraApiSamples/MultiObjectDetection/SentisInference/Model/*.sentis

# ── Meta / Oculus 帳號設定（含敏感資訊）─────────
Assets/Oculus/OculusProjectConfig.asset
Assets/Oculus/OculusProjectSetupSettings.asset
Assets/MetaXR/MetaXRProjectSettings.asset
Assets/Resources/OVRPlatformToolSettings.asset

# ── OS 系統檔 ────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db

# ── 工具腳本（本機用，不需上傳）────────────────
generate_structure.py

# ══ 保留上傳的重要檔案（不排除）═════════════════
# Assets/PassthroughCameraApiSamples/  ← 你的核心程式碼
# Assets/Plugins/Android/AndroidManifest.xml
# Assets/StreamingAssets/              ← 保留空目錄（加 .gitkeep）
# Packages/manifest.json               ← 套件清單（必須上傳）
# Packages/packages-lock.json          ← 版本鎖定（建議上傳）
# ProjectSettings/                     ← 專案設定（必須上傳）
# docs/                                ← Demo GIF（必須上傳）
# Media/                               ← Demo GIF（必須上傳）