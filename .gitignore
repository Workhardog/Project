# ── Burst 編譯快取 ───────────────────────────────
passthroughcamera_BurstDebugInformation_DoNotShip/

# ── Android / CMake 編譯暫存（.utmp）────────────
.utmp/

# ── Visual Studio / Rider 產生的專案檔 ──────────
Assembly-CSharp.csproj
Assembly-CSharp-Editor.csproj
